<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         BIMUP Fluent — Color tokens (BIMUP Agent Studio & UI/UX Pro Max Edition)
         Sleek, enterprise-grade, neutral tones, subtle hairlines, and modern accents.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─── Brand (BIMUP Studio Signature Indigo/Blue #5865D9 / #0F6CBD) ─── -->
    <Color x:Key="BIMUP.Fluent.Color.Accent">#FF4F5BD5</Color>
    <Color x:Key="BIMUP.Fluent.Color.AccentHover">#FF434EC0</Color>
    <Color x:Key="BIMUP.Fluent.Color.AccentPressed">#FF3842A8</Color>
    <Color x:Key="BIMUP.Fluent.Color.AccentLight">#FF6E7AF0</Color>
    <Color x:Key="BIMUP.Fluent.Color.AccentFg">#FFFFFFFF</Color>
    
    <!-- Tinted overlays (selected, hover trên surface sáng) -->
    <Color x:Key="BIMUP.Fluent.Color.AccentTint">#144F5BD5</Color>          <!-- ~8% -->
    <Color x:Key="BIMUP.Fluent.Color.AccentTintHover">#224F5BD5</Color>     <!-- ~13% -->
    <Color x:Key="BIMUP.Fluent.Color.AccentStroke">#334F5BD5</Color>        <!-- 20% -->
    <Color x:Key="BIMUP.Fluent.Color.AccentBg">#0F4F5BD5</Color>            <!-- 6% -->

    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.Accent"        Color="{StaticResource BIMUP.Fluent.Color.Accent}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.AccentHover"   Color="{StaticResource BIMUP.Fluent.Color.AccentHover}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.AccentPressed" Color="{StaticResource BIMUP.Fluent.Color.AccentPressed}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.AccentLight"   Color="{StaticResource BIMUP.Fluent.Color.AccentLight}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.AccentFg"      Color="{StaticResource BIMUP.Fluent.Color.AccentFg}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.AccentTint"      Color="{StaticResource BIMUP.Fluent.Color.AccentTint}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.AccentTintHover" Color="{StaticResource BIMUP.Fluent.Color.AccentTintHover}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.AccentStroke"    Color="{StaticResource BIMUP.Fluent.Color.AccentStroke}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.AccentBg"        Color="{StaticResource BIMUP.Fluent.Color.AccentBg}" />

    <!-- ─── Clean Surfaces (Reference BIMUP Agent Studio) ─── -->
    <Color x:Key="BIMUP.Fluent.Color.MicaBase">#FFF7F8FA</Color>
    <Color x:Key="BIMUP.Fluent.Color.Layer1">#FFFFFFFF</Color>
    <Color x:Key="BIMUP.Fluent.Color.Layer2">#FFFBFBFC</Color>
    <Color x:Key="BIMUP.Fluent.Color.Layer3">#FFF1F3F6</Color>
    <Color x:Key="BIMUP.Fluent.Color.NavPane">#FFF7F8FA</Color>
    <Color x:Key="BIMUP.Fluent.Color.CardBg">#FFFFFFFF</Color>

    <!-- Control fills -->
    <Color x:Key="BIMUP.Fluent.Color.CtrlRest">#FFFFFFFF</Color>
    <Color x:Key="BIMUP.Fluent.Color.CtrlHover">#FFF3F4F7</Color>
    <Color x:Key="BIMUP.Fluent.Color.CtrlPressed">#FFEAECEF</Color>
    <Color x:Key="BIMUP.Fluent.Color.CtrlDisabled">#FFF6F7F9</Color>

    <!-- Subtle (cho ghost button, list item hover) -->
    <Color x:Key="BIMUP.Fluent.Color.SubtleHover">#0A202940</Color>
    <Color x:Key="BIMUP.Fluent.Color.SubtlePressed">#12202940</Color>

    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.MicaBase"    Color="{StaticResource BIMUP.Fluent.Color.MicaBase}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.Layer1"      Color="{StaticResource BIMUP.Fluent.Color.Layer1}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.Layer2"      Color="{StaticResource BIMUP.Fluent.Color.Layer2}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.Layer3"      Color="{StaticResource BIMUP.Fluent.Color.Layer3}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.NavPane"     Color="{StaticResource BIMUP.Fluent.Color.NavPane}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.CardBg"      Color="{StaticResource BIMUP.Fluent.Color.CardBg}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.CtrlRest"    Color="{StaticResource BIMUP.Fluent.Color.CtrlRest}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.CtrlHover"   Color="{StaticResource BIMUP.Fluent.Color.CtrlHover}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.CtrlPressed" Color="{StaticResource BIMUP.Fluent.Color.CtrlPressed}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.CtrlDisabled" Color="{StaticResource BIMUP.Fluent.Color.CtrlDisabled}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.SubtleHover" Color="{StaticResource BIMUP.Fluent.Color.SubtleHover}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.SubtlePressed" Color="{StaticResource BIMUP.Fluent.Color.SubtlePressed}" />

    <!-- ─── Crisp Hairline Strokes (Agent Studio #E7E9EF & #CDD2DF) ─── -->
    <Color x:Key="BIMUP.Fluent.Color.Stroke1">#FFE7E9EF</Color>              <!-- Card & table border -->
    <Color x:Key="BIMUP.Fluent.Color.Stroke2">#FFD8DCE5</Color>              <!-- Input border -->
    <Color x:Key="BIMUP.Fluent.Color.StrokeAccessible">#FFA2A9B8</Color>     <!-- Input bottom accent line -->
    <Color x:Key="BIMUP.Fluent.Color.Divider">#FFE7E9EF</Color>              <!-- Clean divider -->

    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.Stroke1"           Color="{StaticResource BIMUP.Fluent.Color.Stroke1}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.Stroke2"           Color="{StaticResource BIMUP.Fluent.Color.Stroke2}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.StrokeAccessible"  Color="{StaticResource BIMUP.Fluent.Color.StrokeAccessible}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.Divider"           Color="{StaticResource BIMUP.Fluent.Color.Divider}" />

    <!-- ─── Typography Foreground (#262934 / #606575 / #8A8F9E) ─── -->
    <Color x:Key="BIMUP.Fluent.Color.Fg1">#FF262934</Color>
    <Color x:Key="BIMUP.Fluent.Color.Fg2">#FF606575</Color>
    <Color x:Key="BIMUP.Fluent.Color.Fg3">#FF8A8F9E</Color>
    <Color x:Key="BIMUP.Fluent.Color.FgDisabled">#FFC0C4CE</Color>
    <Color x:Key="BIMUP.Fluent.Color.FgOnAccent">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.Fg1"         Color="{StaticResource BIMUP.Fluent.Color.Fg1}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.Fg2"         Color="{StaticResource BIMUP.Fluent.Color.Fg2}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.Fg3"         Color="{StaticResource BIMUP.Fluent.Color.Fg3}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.FgDisabled"  Color="{StaticResource BIMUP.Fluent.Color.FgDisabled}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.FgOnAccent"  Color="{StaticResource BIMUP.Fluent.Color.FgOnAccent}" />

    <!-- ─── Semantic Status Badges & Pills ─── -->
    <Color x:Key="BIMUP.Fluent.Color.Success">#FF2E7D32</Color>
    <Color x:Key="BIMUP.Fluent.Color.SuccessBg">#FFEAF5EF</Color>
    <Color x:Key="BIMUP.Fluent.Color.Warning">#FFB8741A</Color>
    <Color x:Key="BIMUP.Fluent.Color.WarningBg">#FFFFF6E5</Color>
    <Color x:Key="BIMUP.Fluent.Color.Danger">#FFD32F2F</Color>
    <Color x:Key="BIMUP.Fluent.Color.DangerBg">#FFFDEEEF</Color>
    <Color x:Key="BIMUP.Fluent.Color.Star">#FFF59E0B</Color>

    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.Success"   Color="{StaticResource BIMUP.Fluent.Color.Success}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.SuccessBg" Color="{StaticResource BIMUP.Fluent.Color.SuccessBg}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.Warning"   Color="{StaticResource BIMUP.Fluent.Color.Warning}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.WarningBg" Color="{StaticResource BIMUP.Fluent.Color.WarningBg}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.Danger"    Color="{StaticResource BIMUP.Fluent.Color.Danger}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.DangerBg"  Color="{StaticResource BIMUP.Fluent.Color.DangerBg}" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.Star"      Color="{StaticResource BIMUP.Fluent.Color.Star}" />

    <!-- Stroke cho badges -->
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.SuccessStroke" Color="#332E7D32" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.WarningStroke" Color="#33B8741A" />
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.DangerStroke"  Color="#33D32F2F" />

    <!-- ─── App Canvas Background (Clean Studio Neutral) ─── -->
    <SolidColorBrush x:Key="BIMUP.Fluent.Brush.MicaWindow" Color="#FFF7F8FA" />

</ResourceDictionary>
