<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         NavigationView (left pane).
         HTML: nav-item 38px, hover ink subtle, selected = bg #fff 85% +
         shadow-2 + icon brand. Pane bg rgba(252,252,253,0.72), padding 10/8.
         Section label uppercase 11px / 0.4em / fg3.
         WPF: dùng ListBox với ItemContainerStyle riêng — KHÔNG dùng pill
         sliding indicator (HTML có 3px pill di chuyển dọc theo nav-list, WPF
         dùng accent bar bên trái mỗi item là đủ).
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─── Nav pane (Border bao quanh ListBox + header + search) ─── -->
    <Style x:Key="BIMUP.Fluent.Nav.Pane" TargetType="Border">
        <Setter Property="Background"        Value="{DynamicResource BIMUP.Fluent.Brush.NavPane}" />
        <Setter Property="BorderBrush"       Value="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" />
        <Setter Property="BorderThickness"   Value="0,0,1,0" />
        <Setter Property="Padding"           Value="8,10,8,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ─── Nav section label ─── -->
    <Style x:Key="BIMUP.Fluent.Nav.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource BIMUP.Fluent.Font.Text}" />
        <Setter Property="FontSize"   Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BIMUP.Fluent.Brush.Fg3}" />
        <Setter Property="Padding"    Value="12,12,12,4" />
    </Style>

    <!-- ─── Nav item (ListBoxItem variant) ─── -->
    <Style x:Key="BIMUP.Fluent.Nav.Item" TargetType="ListBoxItem">
        <Setter Property="Height"     Value="38" />
        <Setter Property="Padding"    Value="12,0" />
        <Setter Property="Cursor"     Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource BIMUP.Fluent.Font.Text}" />
        <Setter Property="FontSize"   Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource BIMUP.Fluent.Brush.Fg1}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin"     Value="0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource BIMUP.Fluent.Radius.Control}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <!-- Accent pill bên trái khi selected -->
                        <Border x:Name="Pill"
                                Width="3"
                                Height="18"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="-7,0,0,0"
                                CornerRadius="2"
                                Background="{DynamicResource BIMUP.Fluent.Brush.Accent}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BIMUP.Fluent.Brush.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#D9FFFFFF" />
                            <Setter TargetName="Root" Property="Effect"     Value="{DynamicResource BIMUP.Fluent.Shadow.2}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── Nav list (ListBox) ─── -->
    <Style x:Key="BIMUP.Fluent.Nav.List" TargetType="ListBox">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"         Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource BIMUP.Fluent.Nav.Item}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- ─── Logo block (B 34×34 gradient) ─── -->
    <LinearGradientBrush x:Key="BIMUP.Fluent.Nav.LogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2B8FE0" Offset="0" />
        <GradientStop Color="#FF0F6CBD" Offset="0.6" />
        <GradientStop Color="#FF0F548C" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="BIMUP.Fluent.Nav.Logo" TargetType="Border">
        <Setter Property="Width"  Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background"   Value="{StaticResource BIMUP.Fluent.Nav.LogoBrush}" />
        <Setter Property="Effect"       Value="{DynamicResource BIMUP.Fluent.Shadow.4}" />
    </Style>

</ResourceDictionary>
