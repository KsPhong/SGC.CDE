<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         BIMUP Fluent — NavigationView (Left Rail)
         Matches BIMUP Agent Studio: width ~226px, bg-panel-alt (#F7F8FA),
         crisp 1px right border, clean 32px nav items with left accent pill.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─── Nav pane ─── -->
    <Style x:Key="BIMUP.Fluent.Nav.Pane" TargetType="Border">
        <Setter Property="Background"        Value="{DynamicResource BIMUP.Fluent.Brush.NavPane}" />
        <Setter Property="BorderBrush"       Value="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" />
        <Setter Property="BorderThickness"   Value="0,0,1,0" />
        <Setter Property="Padding"           Value="10,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ─── Nav section label ─── -->
    <Style x:Key="BIMUP.Fluent.Nav.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource BIMUP.Fluent.Font.Text}" />
        <Setter Property="FontSize"   Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BIMUP.Fluent.Brush.Fg3}" />
        <Setter Property="Padding"    Value="10,12,10,4" />
    </Style>

    <!-- ─── Nav item (Agent Studio workspace-item style) ─── -->
    <Style x:Key="BIMUP.Fluent.Nav.Item" TargetType="ListBoxItem">
        <Setter Property="Height"     Value="34" />
        <Setter Property="Padding"    Value="10,0" />
        <Setter Property="Cursor"     Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource BIMUP.Fluent.Font.Text}" />
        <Setter Property="FontSize"   Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource BIMUP.Fluent.Brush.Fg2}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin"     Value="0,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource BIMUP.Fluent.Radius.Control}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <!-- Left indicator pill (Agent Studio style) -->
                        <Border x:Name="Pill"
                                Width="3"
                                Height="16"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="-6,0,0,0"
                                CornerRadius="1.5"
                                Background="{DynamicResource BIMUP.Fluent.Brush.Accent}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BIMUP.Fluent.Brush.CtrlHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource BIMUP.Fluent.Brush.Fg1}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FFFFFFFF" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource BIMUP.Fluent.Brush.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── Nav list ─── -->
    <Style x:Key="BIMUP.Fluent.Nav.List" TargetType="ListBox">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"         Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource BIMUP.Fluent.Nav.Item}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- ─── Logo block (BIMUP brand symbol container) ─── -->
    <LinearGradientBrush x:Key="BIMUP.Fluent.Nav.LogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6E7AF0" Offset="0" />
        <GradientStop Color="#FF4F5BD5" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="BIMUP.Fluent.Nav.Logo" TargetType="Border">
        <Setter Property="Width"           Value="30" />
        <Setter Property="Height"          Value="30" />
        <Setter Property="CornerRadius"    Value="7" />
        <Setter Property="Background"      Value="{StaticResource BIMUP.Fluent.Nav.LogoBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
