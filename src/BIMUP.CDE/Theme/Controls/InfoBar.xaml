<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         InfoBar — 4 variant: Info · Success · Warning · Danger.
         Sử dụng dạng <Border Style><Grid>...<icon/title/text/>...</Grid></Border>.
         HTML padding 14 16, border 1px stroke 30% màu, r card 10.
         ═══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="BIMUP.Fluent.InfoBar.Base" TargetType="Border">
        <Setter Property="Padding"         Value="14,12,16,12" />
        <Setter Property="CornerRadius"    Value="{DynamicResource BIMUP.Fluent.Radius.Card}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="BIMUP.Fluent.InfoBar.Info" TargetType="Border" BasedOn="{StaticResource BIMUP.Fluent.InfoBar.Base}">
        <Setter Property="Background"  Value="{DynamicResource BIMUP.Fluent.Brush.AccentBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BIMUP.Fluent.Brush.AccentStroke}" />
    </Style>

    <Style x:Key="BIMUP.Fluent.InfoBar.Success" TargetType="Border" BasedOn="{StaticResource BIMUP.Fluent.InfoBar.Base}">
        <Setter Property="Background"  Value="{DynamicResource BIMUP.Fluent.Brush.SuccessBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BIMUP.Fluent.Brush.SuccessStroke}" />
    </Style>

    <Style x:Key="BIMUP.Fluent.InfoBar.Warning" TargetType="Border" BasedOn="{StaticResource BIMUP.Fluent.InfoBar.Base}">
        <Setter Property="Background"  Value="{DynamicResource BIMUP.Fluent.Brush.WarningBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BIMUP.Fluent.Brush.WarningStroke}" />
    </Style>

    <Style x:Key="BIMUP.Fluent.InfoBar.Danger" TargetType="Border" BasedOn="{StaticResource BIMUP.Fluent.InfoBar.Base}">
        <Setter Property="Background"  Value="{DynamicResource BIMUP.Fluent.Brush.DangerBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BIMUP.Fluent.Brush.DangerStroke}" />
    </Style>

</ResourceDictionary>
