<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         ListView · TreeView · DataGrid (Agent Studio & UI/UX Pro Max Edition)
         Clean border styling, compact headers (32px), sleek row height (34px),
         subtle hover, and high readability.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─── ListView container ─── -->
    <Style x:Key="BIMUP.Fluent.ListView.Surface" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource BIMUP.Fluent.Brush.CtrlRest}" />
        <Setter Property="BorderBrush"     Value="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{DynamicResource BIMUP.Fluent.Radius.Card}" />
        <Setter Property="Padding"         Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ─── ListViewItem ─── -->
    <Style x:Key="BIMUP.Fluent.ListBoxItem" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource BIMUP.Fluent.Font.Text}" />
        <Setter Property="Foreground" Value="{DynamicResource BIMUP.Fluent.Brush.Fg1}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding"    Value="8,6" />
        <Setter Property="Cursor"     Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource BIMUP.Fluent.Radius.Control}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="Pill"
                                Width="3" Height="14"
                                CornerRadius="1.5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="1,0,0,0"
                                Background="{DynamicResource BIMUP.Fluent.Brush.Accent}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BIMUP.Fluent.Brush.CtrlHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BIMUP.Fluent.Brush.AccentTint}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── ListBox ─── -->
    <Style x:Key="BIMUP.Fluent.ListBox" TargetType="ListBox">
        <Setter Property="Background"          Value="Transparent" />
        <Setter Property="BorderThickness"     Value="0" />
        <Setter Property="Padding"             Value="0" />
        <Setter Property="ItemContainerStyle"  Value="{StaticResource BIMUP.Fluent.ListBoxItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         DataGrid Clean Studio Style
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="BIMUP.Fluent.DataGrid" TargetType="DataGrid">
        <Setter Property="Background"      Value="{DynamicResource BIMUP.Fluent.Brush.CtrlRest}" />
        <Setter Property="BorderBrush"     Value="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground"   Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#04202940" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility"   Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows"      Value="False" />
        <Setter Property="CanUserDeleteRows"   Value="False" />
        <Setter Property="CanUserResizeRows"   Value="False" />
        <Setter Property="SelectionMode"       Value="Single" />
        <Setter Property="SelectionUnit"       Value="FullRow" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" />
        <Setter Property="VerticalGridLinesBrush"   Value="Transparent" />
        <Setter Property="FontFamily"      Value="{DynamicResource BIMUP.Fluent.Font.Text}" />
        <Setter Property="FontSize"        Value="12.5" />
        <Setter Property="Foreground"      Value="{DynamicResource BIMUP.Fluent.Brush.Fg1}" />
        <Setter Property="ColumnHeaderHeight" Value="34" />
        <Setter Property="RowHeight"          Value="34" />
    </Style>

    <Style x:Key="BIMUP.Fluent.DataGrid.ColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background"  Value="{DynamicResource BIMUP.Fluent.Brush.Layer3}" />
        <Setter Property="Foreground"  Value="{DynamicResource BIMUP.Fluent.Brush.Fg2}" />
        <Setter Property="FontSize"    Value="10.5" />
        <Setter Property="FontWeight"  Value="SemiBold" />
        <Setter Property="Padding"     Value="12,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
    </Style>

    <Style x:Key="BIMUP.Fluent.DataGrid.Row" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor"     Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource BIMUP.Fluent.Font.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BIMUP.Fluent.Brush.CtrlHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource BIMUP.Fluent.Brush.AccentTintHover}" />
                <Setter Property="Foreground" Value="{DynamicResource BIMUP.Fluent.Brush.Fg1}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BIMUP.Fluent.DataGrid.Cell" TargetType="DataGridCell">
        <Setter Property="Padding"           Value="12,0" />
        <Setter Property="BorderThickness"   Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background"        Value="Transparent" />
        <Setter Property="FocusVisualStyle"  Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
