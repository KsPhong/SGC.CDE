<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════════════
         BIMUP Fluent — Design tokens (Compact, Precision Desktop, Agent Style)
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─── Spacing scale ─── -->
    <sys:Double x:Key="BIMUP.Fluent.Space.1">4</sys:Double>
    <sys:Double x:Key="BIMUP.Fluent.Space.2">8</sys:Double>
    <sys:Double x:Key="BIMUP.Fluent.Space.3">12</sys:Double>
    <sys:Double x:Key="BIMUP.Fluent.Space.4">16</sys:Double>
    <sys:Double x:Key="BIMUP.Fluent.Space.5">20</sys:Double>
    <sys:Double x:Key="BIMUP.Fluent.Space.6">24</sys:Double>

    <!-- ─── Corner radius (Modern Subtle Curvature: 6 / 8 / 999) ─── -->
    <CornerRadius x:Key="BIMUP.Fluent.Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="BIMUP.Fluent.Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="BIMUP.Fluent.Radius.Flyout">8</CornerRadius>
    <CornerRadius x:Key="BIMUP.Fluent.Radius.Pill">999</CornerRadius>
    <CornerRadius x:Key="BIMUP.Fluent.Radius.Sm">4</CornerRadius>

    <sys:Double x:Key="BIMUP.Fluent.RadiusN.Control">6</sys:Double>
    <sys:Double x:Key="BIMUP.Fluent.RadiusN.Card">8</sys:Double>

    <!-- ─── Desktop Control sizing (32px standard, 28px compact) ─── -->
    <sys:Double x:Key="BIMUP.Fluent.Size.CtrlSm">26</sys:Double>
    <sys:Double x:Key="BIMUP.Fluent.Size.Ctrl">32</sys:Double>
    <sys:Double x:Key="BIMUP.Fluent.Size.CtrlLg">38</sys:Double>

    <!-- ─── Padding presets ─── -->
    <Thickness x:Key="BIMUP.Fluent.Padding.Input">10,0,10,0</Thickness>
    <Thickness x:Key="BIMUP.Fluent.Padding.Button">12,0,12,0</Thickness>
    <Thickness x:Key="BIMUP.Fluent.Padding.ButtonSm">8,0,8,0</Thickness>
    <Thickness x:Key="BIMUP.Fluent.Padding.ButtonLg">18,0,18,0</Thickness>
    <Thickness x:Key="BIMUP.Fluent.Padding.Card">16,14,16,14</Thickness>

    <!-- ─── Motion ─── -->
    <KeySpline x:Key="BIMUP.Fluent.Spline.Decel"  ControlPoint1="0.1,0.9"  ControlPoint2="0.2,1" />
    <KeySpline x:Key="BIMUP.Fluent.Spline.Std"    ControlPoint1="0.33,0"   ControlPoint2="0.1,1" />
    <KeySpline x:Key="BIMUP.Fluent.Spline.Soft"   ControlPoint1="0.16,1"   ControlPoint2="0.3,1" />

    <Duration x:Key="BIMUP.Fluent.Dur.Fast">0:0:0.10</Duration>
    <Duration x:Key="BIMUP.Fluent.Dur.Norm">0:0:0.18</Duration>
    <Duration x:Key="BIMUP.Fluent.Dur.Slow">0:0:0.25</Duration>

    <!-- ─── Elevation (Subtle, crisp shadows like Agent Studio) ─── -->
    <DropShadowEffect x:Key="BIMUP.Fluent.Shadow.2"  BlurRadius="4"  ShadowDepth="1" Direction="270" Opacity="0.04" Color="#000000" />
    <DropShadowEffect x:Key="BIMUP.Fluent.Shadow.4"  BlurRadius="8"  ShadowDepth="2" Direction="270" Opacity="0.06" Color="#000000" />
    <DropShadowEffect x:Key="BIMUP.Fluent.Shadow.8"  BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.08" Color="#000000" />
    <DropShadowEffect x:Key="BIMUP.Fluent.Shadow.16" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.10" Color="#000000" />
    <DropShadowEffect x:Key="BIMUP.Fluent.Shadow.28" BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.12" Color="#000000" />
    <DropShadowEffect x:Key="BIMUP.Fluent.Shadow.64" BlurRadius="48" ShadowDepth="16" Direction="270" Opacity="0.14" Color="#000000" />

    <!-- ─── Typography Fonts ─── -->
    <FontFamily x:Key="BIMUP.Fluent.Font.Text">Segoe UI Variable Text, Segoe UI, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="BIMUP.Fluent.Font.Display">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="BIMUP.Fluent.Font.Mono">Cascadia Code, Consolas, monospace</FontFamily>

</ResourceDictionary>
