<ui:FluentWindow x:Class="BIMUP.CDE.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:local="clr-namespace:BIMUP.CDE"
                  xmlns:models="clr-namespace:BIMUP.CDE.Models"
                  Title="SGC CDE Studio"
                  Width="1440" Height="880" MinWidth="1050" MinHeight="680"
                  WindowStartupLocation="CenterScreen"
                  FontFamily="{DynamicResource BIMUP.Fluent.Font.Text}"
                  Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg1}"
                  Padding="0,0,0,8"
                  WindowBackdropType="Mica"
                  ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Nút chuẩn Agent Studio & UI/UX Pro Max -->
        <Style x:Key="Btn.Accent" TargetType="Button" BasedOn="{StaticResource BIMUP.Fluent.Button.Accent}">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Btn.Outline" TargetType="Button" BasedOn="{StaticResource BIMUP.Fluent.Button.Outline}">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Btn.Subtle" TargetType="Button" BasedOn="{StaticResource BIMUP.Fluent.Button.Subtle}">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BIMUP.Fluent.Text.FieldLabel}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource BIMUP.Fluent.Text.FieldHint}">
            <Setter Property="Foreground" Value="{DynamicResource BIMUP.Fluent.Brush.Fg3}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,2,2,6" />
        </Style>
        <Style x:Key="Card.Flat" TargetType="Border" BasedOn="{StaticResource BIMUP.Fluent.Card}">
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- Logo BIMUP CDE Hub SVG (Agent Studio style mark) -->
        <DataTemplate x:Key="HubLogo">
            <Viewbox>
                <Canvas Width="100" Height="100">
                    <Line X1="50" Y1="50" X2="20" Y2="20" Stroke="#B9D7F5" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Line X1="50" Y1="50" X2="80" Y2="20" Stroke="#B9D7F5" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Line X1="50" Y1="50" X2="80" Y2="80" Stroke="#B9D7F5" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Line X1="50" Y1="50" X2="20" Y2="80" Stroke="#B9D7F5" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Ellipse Canvas.Left="12" Canvas.Top="12" Width="18" Height="18" Fill="White" />
                    <Ellipse Canvas.Left="70" Canvas.Top="12" Width="18" Height="18" Fill="White" />
                    <Ellipse Canvas.Left="70" Canvas.Top="70" Width="18" Height="18" Fill="White" />
                    <Ellipse Canvas.Left="12" Canvas.Top="70" Width="18" Height="18" Fill="White" />
                    <Ellipse Canvas.Left="35" Canvas.Top="35" Width="30" Height="30" Fill="{DynamicResource BIMUP.Fluent.Brush.Accent}" />
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <Style x:Key="Pages" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <TabPanel IsItemsHost="True" Visibility="Collapsed" />
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource BIMUP.Fluent.Brush.MicaWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ════ TOPBAR: SGC STUDIO BREADCRUMB STYLE ════ -->
        <ui:TitleBar Grid.Row="0" Height="46">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="▧" FontSize="14" Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="SGC Studio" FontSize="12.5" FontWeight="Normal" Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" VerticalAlignment="Center" />
                    <TextBlock Text="/" FontSize="12.5" Foreground="{DynamicResource BIMUP.Fluent.Brush.StrokeAccessible}" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Text="CDE Cloud Workspace" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg1}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ACC · BIM 360" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg3}" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ════ THANH ĐIỀU HƯỚNG BÊN TRÁI (SGC SIDEBAR) ════ -->
            <Border Style="{StaticResource BIMUP.Fluent.Nav.Pane}">
                <DockPanel>
                    <!-- Brand Header -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,4,16">
                        <Border Style="{StaticResource BIMUP.Fluent.Nav.Logo}" Padding="5">
                            <ContentPresenter ContentTemplate="{StaticResource HubLogo}" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SGC " FontFamily="{DynamicResource BIMUP.Fluent.Font.Display}"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg1}" />
                                <TextBlock Text="CDE" FontFamily="{DynamicResource BIMUP.Fluent.Font.Display}"
                                           FontSize="15" FontWeight="Normal"
                                           Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" />
                            </StackPanel>
                            <TextBlock Text="Không gian làm việc CDE" FontSize="10.5"
                                       Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg3}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Section Label -->
                    <TextBlock DockPanel.Dock="Top" Text="ĐIỀU HƯỚNG CDE" Style="{StaticResource BIMUP.Fluent.Nav.SectionLabel}" />

                    <!-- Trạng thái kết nối ACC & MCP ở đáy Sidebar (Pill Style) -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource BIMUP.Fluent.Card.Section}" Margin="2,8,2,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TRẠNG THÁI HỆ THỐNG" Style="{StaticResource BIMUP.Fluent.Text.Eyebrow}" />
                                <Border Grid.Column="1" Background="{DynamicResource BIMUP.Fluent.Brush.SuccessBg}" CornerRadius="3" Padding="5,1">
                                    <TextBlock Text="ONLINE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BIMUP.Fluent.Brush.Success}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="6" Height="6" Margin="2,0,8,0"
                                         VerticalAlignment="Center" Fill="{DynamicResource BIMUP.Fluent.Brush.Success}" />
                                <TextBlock x:Name="TxtMcpStatus" Grid.Column="1" Text="MCP Bridge: Đang chạy" FontSize="11"
                                           Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="2,0,8,0"
                                         VerticalAlignment="Center" Fill="{DynamicResource BIMUP.Fluent.Brush.Danger}" />
                                <TextBlock x:Name="TxtConnectionStatus" Grid.Column="1" Text="ACC: Chưa kết nối"
                                           FontSize="11" Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Button Style="{StaticResource Btn.Outline}" Height="28" HorizontalAlignment="Stretch"
                                    Click="BtnQuickConnect_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PlugConnected24" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Kết nối ACC ngay" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Danh mục Navigation (Agent Studio items) -->
                    <ListBox x:Name="NavList" Style="{StaticResource BIMUP.Fluent.Nav.List}"
                             SelectedIndex="0" SelectionChanged="NavList_SelectionChanged">
                        <ListBoxItem Tag="Tài liệu &amp; Cây Thư Mục Dự Án">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,10,0"
                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" />
                                <TextBlock Text="Tài liệu &amp; File" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Thành viên, Role &amp; Phân quyền Thư mục">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="16" Margin="0,0,10,0"
                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" />
                                <TextBlock Text="Thành viên &amp; Role" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Cài đặt Quy trình Phê duyệt (Approval Workflows)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flow20" FontSize="16" Margin="0,0,10,0"
                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" />
                                <TextBlock Text="Cài đặt Quy trình" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Danh sách Đợt trình duyệt hồ sơ (Reviews)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkStarburst24" FontSize="16" Margin="0,0,10,0"
                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" />
                                <TextBlock Text="Đợt trình duyệt" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Vấn đề Dự án (Issues) &amp; Hồ sơ Phát hành (Transmittals)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning24" FontSize="16" Margin="0,0,10,0"
                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" />
                                <TextBlock Text="Issues &amp; Phát hành" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Đồng bộ &amp; Sao lưu tự động (Backup)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CloudArrowDown24" FontSize="16" Margin="0,0,10,0"
                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" />
                                <TextBlock Text="Đồng bộ &amp; Backup" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Cấu hình API &amp; Hướng dẫn kết nối">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Key24" FontSize="16" Margin="0,0,10,0"
                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" />
                                <TextBlock Text="Cấu hình API" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Nhật ký hoạt động hệ thống">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentText24" FontSize="16" Margin="0,0,10,0"
                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" />
                                <TextBlock Text="Nhật ký hệ thống" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ════ KHU VỰC NỘI DUNG CHÍNH (CENTER STAGE) ════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ─── HEADER TOOLBAR: TITLE + PROJECT SELECTORS ─── -->
                <Grid Margin="20,12,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPageTitle" Style="{StaticResource BIMUP.Fluent.Text.Title}"
                                   Text="{Binding SelectedItem.Tag, ElementName=NavList}" />
                        <TextBlock x:Name="TxtProgressStatus"
                                   Text="Sẵn sàng kết nối Autodesk Construction Cloud"
                                   FontSize="11.5" Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg3}" Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- Clean Sleek Capsule Selector -->
                    <Border Grid.Column="1" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                            BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Hub" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg3}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <ComboBox x:Name="CboHubs" Width="135" Height="30" SelectionChanged="CboHubs_SelectionChanged"
                                          ToolTip="Tài khoản ACC / Hub" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Dự án" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg3}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <ComboBox x:Name="CboProjects" Width="180" Height="30" SelectionChanged="CboProjects_SelectionChanged"
                                          ToolTip="Dự án ACC đang chọn" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="Gốc" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg3}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <ComboBox x:Name="CboTopFolders" Width="150" Height="30" SelectionChanged="CboTopFolders_SelectionChanged"
                                          ToolTip="Thư mục gốc (Top Folder)" />
                            </StackPanel>

                            <!-- Cụm nút hành động dự án -->
                            <Button x:Name="BtnScanFiles" Style="{StaticResource Btn.Accent}"
                                    Padding="12,0" Height="30" Click="BtnScanFiles_Click"
                                    ToolTip="Quét cấu trúc cây thư mục và danh sách file">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Search24" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Quét Cây File" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnLoadGovernance" Style="{StaticResource Btn.Outline}"
                                    Padding="10,0" Height="30" Click="BtnLoadGovernance_Click"
                                    ToolTip="Đồng bộ thủ công Roles, Members, Quy trình &amp; Reviews">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Đồng bộ" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnCancelTask" Style="{StaticResource Btn.Subtle}"
                                    Visibility="Collapsed" Click="BtnCancelTask_Click" ToolTip="Dừng tác vụ hiện tại">
                                <ui:SymbolIcon Symbol="DismissCircle24" FontSize="15" Foreground="{DynamicResource BIMUP.Fluent.Brush.Danger}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ─── NỘI DUNG TỪNG TRANG (TABCONTROL) ─── -->
                <TabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource Pages}"
                            SelectedIndex="{Binding SelectedIndex, ElementName=NavList, Mode=OneWay}"
                            Margin="20,0,20,10">

                    <!-- ═══ TAB 0: EXPLORER CÂY THƯ MỤC & FILE DỰ ÁN ═══ -->
                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Thanh Breadcrumb + Toolbar tìm kiếm -->
                            <Border Grid.Row="0" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                    BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Breadcrumb -->
                                    <Border Grid.Column="0" Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}"
                                            BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <DockPanel>
                                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="FolderOpen24" FontSize="15"
                                                           Foreground="{DynamicResource FolderGoldBrush}" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtCurrentBreadcrumb" Text="Project Files"
                                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>

                                    <TextBox x:Name="TxtSearchFilter" Grid.Column="1" Height="30" Margin="0,0,8,0"
                                             ToolTip="Lọc nhanh tên file, thư mục, người cập nhật..."
                                             TextChanged="FilterChanged" />

                                    <ComboBox x:Name="CboExtFilter" Grid.Column="2" SelectedIndex="0" Height="30" Margin="0,0,8,0"
                                              SelectionChanged="FilterChanged">
                                        <ComboBoxItem Content="Tất cả loại (*.*)" />
                                        <ComboBoxItem Content="Revit (RVT / RFA)" />
                                        <ComboBoxItem Content="AutoCAD / C3D (DWG)" />
                                        <ComboBoxItem Content="Navis / IFC (NWD / IFC)" />
                                        <ComboBoxItem Content="PDF / Office" />
                                    </ComboBox>

                                    <CheckBox x:Name="ChkCustomAttributes" Grid.Column="3" Margin="4,0,10,0"
                                              IsChecked="True" Content="Custom Attrs" VerticalAlignment="Center"
                                              ToolTip="Lấy thêm thuộc tính tùy chỉnh trên ACC Docs" />

                                    <Border Grid.Column="4" Background="{DynamicResource BIMUP.Fluent.Brush.AccentBg}"
                                            BorderBrush="{DynamicResource BIMUP.Fluent.Brush.AccentStroke}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSummaryCount" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}"
                                                   Text="0 thư mục  ·  0 files" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Khu vực Explorer: Trái (Cây thư mục) <-> Phải (Bảng Thư mục & Bảng File) -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" MinWidth="200" MaxWidth="500" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" MinWidth="450" />
                                </Grid.ColumnDefinitions>

                                <!-- CỘT TRÁI: CÂY THƯ MỤC -->
                                <Border Grid.Column="0" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                        BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                        CornerRadius="8" Padding="8,10">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Folder24" FontSize="15" Foreground="{DynamicResource FolderGoldBrush}" Margin="0,0,6,0" />
                                                <TextBlock Text="CÂY THƯ MỤC" Style="{StaticResource BIMUP.Fluent.Text.LabelSm}"
                                                           Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Style="{StaticResource Btn.Subtle}" Padding="5,1"
                                                        ToolTip="Mở rộng toàn bộ cây" Click="BtnExpandTree_Click" Content="Mở hết" />
                                                <Button Style="{StaticResource Btn.Subtle}" Padding="5,1"
                                                        ToolTip="Thu gọn cây" Click="BtnCollapseTree_Click" Content="Thu gọn" />
                                            </StackPanel>
                                        </Grid>

                                        <TreeView x:Name="TreeFolders" BorderThickness="0" Background="Transparent"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  SelectedItemChanged="TreeFolders_SelectedItemChanged">
                                            <TreeView.ItemTemplate>
                                                <HierarchicalDataTemplate DataType="{x:Type models:AccFolder}" ItemsSource="{Binding Children}">
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" Filled="True" FontSize="15"
                                                                       Foreground="{DynamicResource FolderGoldBrush}"
                                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   VerticalAlignment="Center" FontSize="12.5"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="2" CornerRadius="8" Padding="5,1" Margin="6,0,2,0"
                                                                Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}"
                                                                Visibility="{Binding HasObjects, Converter={StaticResource BoolVis}}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ObjectCount}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg3}" />
                                                        </Border>
                                                    </Grid>
                                                </HierarchicalDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </DockPanel>
                                </Border>

                                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                                <!-- CỘT PHẢI: 2 TẦNG (THƯ MỤC CON & DANH SÁCH FILE) -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="180" MinHeight="80" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="*" MinHeight="160" />
                                    </Grid.RowDefinitions>

                                    <!-- BẢNG THƯ MỤC CON -->
                                    <Border Grid.Row="0" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                            BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                            CornerRadius="8" Padding="0">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}"
                                                    BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="0,0,0,1"
                                                    CornerRadius="7,7,0,0" Padding="12,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="FolderOpen24" Filled="True" FontSize="15"
                                                                       Foreground="{DynamicResource FolderGoldBrush}" Margin="0,0,6,0" />
                                                        <TextBlock Text="THƯ MỤC CON (Nhấp đúp dòng để mở)"
                                                                   FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtFolderHeaderCount" Grid.Column="1" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg3}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <DataGrid x:Name="GridFolders" BorderThickness="0"
                                                      GridLinesVisibility="None"
                                                      MouseDoubleClick="GridFolders_MouseDoubleClick">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="TÊN THƯ MỤC" Width="260" SortMemberPath="Name">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate DataType="{x:Type models:AccFolder}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                                                    <ui:SymbolIcon Symbol="Folder24" Filled="True" FontSize="17"
                                                                                   Foreground="{DynamicResource FolderGoldBrush}" Margin="0,0,10,0" />
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="ĐƯỜNG DẪN ĐẦY ĐỦ" Binding="{Binding FullPath}" Width="300" />
                                                    <DataGridTemplateColumn Header="SỐ MỤC" Width="90" SortMemberPath="ObjectCount">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate DataType="{x:Type models:AccFolder}">
                                                                <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                                                        Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}">
                                                                    <TextBlock Text="{Binding ObjectCount}" FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="NGƯỜI TẠO" Binding="{Binding CreateUserName}" Width="140" />
                                                    <DataGridTextColumn Header="NGÀY TẠO" Binding="{Binding CreateTime}" Width="130" />
                                                    <DataGridTextColumn Header="NGƯỜI CẬP NHẬT" Binding="{Binding LastModifiedUserName}" Width="140" />
                                                    <DataGridTextColumn Header="NGÀY CẬP NHẬT" Binding="{Binding LastModifiedTime}" Width="130" />
                                                    <DataGridTextColumn Header="FOLDER ID" Binding="{Binding Id}" Width="200" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

                                    <!-- BẢNG FILE CHI TIẾT -->
                                    <Border Grid.Row="2" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                            BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                            CornerRadius="8" Padding="0">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}"
                                                    BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="0,0,0,1"
                                                    CornerRadius="7,7,0,0" Padding="12,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Document24" FontSize="15"
                                                                       Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" Margin="0,0,6,0" />
                                                        <TextBlock Text="DANH SÁCH FILE &amp; PHIÊN BẢN"
                                                                   FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtFileHeaderCount" Grid.Column="1" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg3}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <DataGrid x:Name="GridFiles" BorderThickness="0" IsReadOnly="False" GridLinesVisibility="None">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="CHỌN" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="52" />
                                                    <DataGridTemplateColumn Header="TÊN FILE" Width="260" SortMemberPath="FileName" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate DataType="{x:Type models:AccFileItem}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                                                    <ui:SymbolIcon Symbol="DocumentText24" FontSize="16"
                                                                                   Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" Margin="0,0,8,0" />
                                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="LOẠI" Width="75" SortMemberPath="FileType" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate DataType="{x:Type models:AccFileItem}">
                                                                <Border CornerRadius="3" Padding="5,1" HorizontalAlignment="Left"
                                                                        Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}">
                                                                    <TextBlock Text="{Binding FileType}" FontSize="10.5" FontWeight="Bold"
                                                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg1}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="VER" Width="65" SortMemberPath="VersionNumber" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate DataType="{x:Type models:AccFileItem}">
                                                                <Border CornerRadius="8" Padding="6,1" HorizontalAlignment="Left"
                                                                        Background="{DynamicResource BIMUP.Fluent.Brush.AccentBg}"
                                                                        BorderBrush="{DynamicResource BIMUP.Fluent.Brush.AccentStroke}" BorderThickness="1">
                                                                    <TextBlock Text="{Binding VersionDisplay}" FontSize="10.5" FontWeight="Bold"
                                                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="DUNG LƯỢNG" Binding="{Binding SizeDisplay}" IsReadOnly="True" Width="95" />
                                                    <DataGridTemplateColumn Header="TRẠNG THÁI DUYỆT" Width="130" SortMemberPath="ReviewState" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate DataType="{x:Type models:AccFileItem}">
                                                                <Border x:Name="RevBadge" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left"
                                                                        Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}">
                                                                    <TextBlock x:Name="RevText" Text="{Binding ReviewState}" FontSize="10.5" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" />
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding ReviewState}" Value="APPROVED">
                                                                        <Setter TargetName="RevBadge" Property="Background" Value="{DynamicResource BIMUP.Fluent.Brush.SuccessBg}" />
                                                                        <Setter TargetName="RevText" Property="Foreground" Value="{DynamicResource BIMUP.Fluent.Brush.Success}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ReviewState}" Value="IN_REVIEW">
                                                                        <Setter TargetName="RevBadge" Property="Background" Value="{DynamicResource BIMUP.Fluent.Brush.WarningBg}" />
                                                                        <Setter TargetName="RevText" Property="Foreground" Value="{DynamicResource BIMUP.Fluent.Brush.Warning}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ReviewState}" Value="REJECTED">
                                                                        <Setter TargetName="RevBadge" Property="Background" Value="{DynamicResource BIMUP.Fluent.Brush.DangerBg}" />
                                                                        <Setter TargetName="RevText" Property="Foreground" Value="{DynamicResource BIMUP.Fluent.Brush.Danger}" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="ĐƯỜNG DẪN THƯ MỤC" Binding="{Binding FolderPath}" IsReadOnly="True" Width="220" />
                                                    <DataGridTextColumn Header="NGƯỜI CẬP NHẬT" Binding="{Binding LastModifiedUserName}" IsReadOnly="True" Width="135" />
                                                    <DataGridTextColumn Header="NGÀY CẬP NHẬT" Binding="{Binding LastModifiedTime}" IsReadOnly="True" Width="125" />
                                                    <DataGridTextColumn Header="CUSTOM ATTRIBUTES" Binding="{Binding CustomAttributesSummary}" IsReadOnly="True" Width="220" />
                                                    <DataGridTextColumn Header="TRẠNG THÁI TẢI" Binding="{Binding SyncStatus}" IsReadOnly="True" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Thanh tác vụ đáy Tab 0 -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn.Subtle}" Click="BtnSelectAll_Click" Padding="10,0" Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="13" Margin="0,0,4,0" />
                                            <TextBlock Text="Chọn tất cả" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Subtle}" Click="BtnUnselectAll_Click" Padding="10,0" Margin="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Margin="0,0,4,0" />
                                            <TextBlock Text="Bỏ chọn" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn.Outline}" Click="BtnExportFoldersCsv_Click" Padding="12,0" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Xuất Thư mục (.CSV)" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Outline}" Click="BtnExportCsv_Click" Padding="12,0" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="DocumentTable24" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Xuất bảng File (.CSV)" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Accent}" Click="BtnDownloadSelected_Click" Padding="14,0" Margin="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Tải File đã chọn" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ═══ TAB 1: THÀNH VIÊN, ROLE & PHÂN QUYỀN THƯ MỤC ═══ -->
                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="220" MinHeight="120" />
                            </Grid.RowDefinitions>

                            <!-- Thanh lọc Thành viên & Role -->
                            <Border Grid.Row="0" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                    BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtMemberSearch" Grid.Column="0" Height="30" Margin="0,0,10,0"
                                             ToolTip="Tìm nhanh theo tên Role, tên Thành viên, Email, Công ty, Thư mục..."
                                             TextChanged="TxtMemberSearch_TextChanged" />
                                    <Border Grid.Column="1" Background="{DynamicResource BIMUP.Fluent.Brush.AccentBg}"
                                            BorderBrush="{DynamicResource BIMUP.Fluent.Brush.AccentStroke}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtGovernanceSummary" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}"
                                                   Text="0 Roles  ·  0 Thành viên  ·  0 Phân quyền" />
                                    </Border>
                                    <Button Grid.Column="2" Style="{StaticResource Btn.Outline}" Padding="12,0" Margin="0,0,6,0"
                                            Click="BtnScanAllFolderPermissions_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Quét Phân quyền Thư mục" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="3" Style="{StaticResource Btn.Accent}" Padding="14,0" Margin="0"
                                            Click="BtnExportMembersRolesCsv_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="DocumentTable24" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Xuất Role &amp; Member (.CSV)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- CỘT TRÁI (ROLES) <-> CỘT PHẢI (THÀNH VIÊN) -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="380" MinWidth="250" MaxWidth="600" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" MinWidth="380" />
                                </Grid.ColumnDefinitions>

                                <!-- ROLES -->
                                <Border Grid.Column="0" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                        BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                        CornerRadius="8" Padding="0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}"
                                                BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="0,0,0,1"
                                                CornerRadius="7,7,0,0" Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Badge24" FontSize="15"
                                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" Margin="0,0,6,0" />
                                                <TextBlock Text="DANH SÁCH ROLES (INDUSTRY ROLES)"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <DataGrid x:Name="GridRoles" BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="TÊN ROLE" Binding="{Binding Name}" Width="200" FontWeight="SemiBold" />
                                                <DataGridTextColumn Header="DỊCH VỤ (SERVICES)" Binding="{Binding ServicesSummary}" Width="190" />
                                                <DataGridTextColumn Header="MEMBER GROUP ID" Binding="{Binding MemberGroupId}" Width="140" />
                                                <DataGridTextColumn Header="ROLE ID" Binding="{Binding Id}" Width="200" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>

                                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                                <!-- MEMBERS -->
                                <Border Grid.Column="2" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                        BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                        CornerRadius="8" Padding="0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}"
                                                BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="0,0,0,1"
                                                CornerRadius="7,7,0,0" Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="15"
                                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" Margin="0,0,6,0" />
                                                <TextBlock Text="DANH SÁCH THÀNH VIÊN DỰ ÁN &amp; HUB"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <DataGrid x:Name="GridMembers" BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="PHẠM VI" Binding="{Binding Scope}" Width="85" />
                                                <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding Name}" Width="160" FontWeight="SemiBold" />
                                                <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="190" />
                                                <DataGridTextColumn Header="CÔNG TY" Binding="{Binding CompanyName}" Width="140" />
                                                <DataGridTextColumn Header="ROLES" Binding="{Binding RolesSummary}" Width="200" />
                                                <DataGridTextColumn Header="CẤP QUYỀN" Binding="{Binding AccessLevel}" Width="125" />
                                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="90" />
                                                <DataGridTextColumn Header="MODULES" Binding="{Binding ProductsSummary}" Width="220" />
                                                <DataGridTextColumn Header="NGÀY THAM GIA" Binding="{Binding AddedOn}" Width="120" />
                                                <DataGridTextColumn Header="AUTODESK ID" Binding="{Binding AutodeskId}" Width="140" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

                            <!-- PHÂN QUYỀN THƯ MỤC -->
                            <Border Grid.Row="3" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                    BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                    CornerRadius="8" Padding="0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}"
                                            BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="0,0,0,1"
                                            CornerRadius="7,7,0,0" Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="15"
                                                           Foreground="{DynamicResource FolderGoldBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="PHÂN QUYỀN TRUY CẬP THƯ MỤC (FOLDER PERMISSIONS)"
                                                       FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid x:Name="GridPermissions" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ĐƯỜNG DẪN THƯ MỤC" Binding="{Binding FolderPath}" Width="240" FontWeight="SemiBold" />
                                            <DataGridTextColumn Header="LOẠI ĐỐI TƯỢNG" Binding="{Binding SubjectType}" Width="110" />
                                            <DataGridTextColumn Header="TÊN ROLE / USER / CÔNG TY" Binding="{Binding SubjectName}" Width="200" FontWeight="SemiBold" />
                                            <DataGridTextColumn Header="EMAIL / PHÂN LOẠI" Binding="{Binding EmailOrInfo}" Width="180" />
                                            <DataGridTextColumn Header="MỨC QUYỀN" Binding="{Binding PermissionLevel}" Width="180" />
                                            <DataGridTextColumn Header="QUYỀN TRỰC TIẾP" Binding="{Binding ActionsSummary}" Width="200" />
                                            <DataGridTextColumn Header="QUYỀN KẾ THỪA" Binding="{Binding InheritActionsSummary}" Width="200" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ═══ TAB 2: CÀI ĐẶT QUY TRÌNH PHÊ DUYỆT (APPROVAL WORKFLOWS) ═══ -->
                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" MinHeight="160" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="2*" MinHeight="160" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                    BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtWorkflowSearch" Grid.Column="0" Height="30" Margin="0,0,10,0"
                                             ToolTip="Tìm nhanh tên Quy trình, Role phê duyệt, Số bước, Mô tả..."
                                             TextChanged="TxtWorkflowSearch_TextChanged" />
                                    <Border Grid.Column="1" Background="{DynamicResource BIMUP.Fluent.Brush.AccentBg}"
                                            BorderBrush="{DynamicResource BIMUP.Fluent.Brush.AccentStroke}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtWorkflowSummary" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}"
                                                   Text="0 Quy trình phê duyệt" />
                                    </Border>
                                    <Button Grid.Column="2" Style="{StaticResource Btn.Accent}" Padding="14,0" Margin="0"
                                            Click="BtnExportWorkflowsCsv_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="DocumentTable24" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Xuất Bảng Quy Trình (.CSV)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- BẢNG WORKFLOWS -->
                            <Border Grid.Row="1" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                    BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                    CornerRadius="8" Padding="0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}"
                                            BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="0,0,0,1"
                                            CornerRadius="7,7,0,0" Padding="12,6">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Flow20" FontSize="15"
                                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" Margin="0,0,6,0" />
                                                <TextBlock Text="DANH SÁCH CÀI ĐẶT QUY TRÌNH (APPROVAL WORKFLOWS)"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg3}"
                                                       Text="💡 Click vào một dòng quy trình để xem chi tiết và cấu hình sơ đồ Node bên dưới" />
                                        </Grid>
                                    </Border>
                                    <DataGrid x:Name="GridWorkflows" BorderThickness="0"
                                              SelectionMode="Single"
                                              SelectionChanged="GridWorkflows_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="TÊN QUY TRÌNH" Binding="{Binding Name}" Width="320" FontWeight="SemiBold" />
                                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="95" />
                                            <DataGridTextColumn Header="SỐ BƯỚC" Binding="{Binding StepCount}" Width="80" />
                                            <DataGridTextColumn Header="KẾT QUẢ DUYỆT" Binding="{Binding ApprovalOptionsSummary}" Width="190" />
                                            <DataGridTextColumn Header="MÔ TẢ" Binding="{Binding Description}" Width="*" />
                                            <DataGridTextColumn Header="NGÀY TẠO" Binding="{Binding CreatedAt}" Width="125" />
                                            <DataGridTextColumn Header="NGƯỜI TẠO" Binding="{Binding CreatedBy}" Width="140" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

                            <!-- ═══ CHI TIẾT CÁC BƯỚC (NODE FLOW CANVAS) ═══ -->
                            <Border Grid.Row="3" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                    BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                    CornerRadius="8" Padding="0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}"
                                            BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="0,0,0,1"
                                            CornerRadius="7,7,0,0" Padding="12,6">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Diagram24" FontSize="15"
                                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" Margin="0,0,6,0" />
                                                <TextBlock x:Name="TxtSelectedWorkflowTitle"
                                                           Text="SƠ ĐỒ LUỒNG CÁC BƯỚC &amp; HÀNH ĐỘNG (NODE FLOW DIAGRAM)"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="BtnSaveWorkflowToAcc" Style="{StaticResource Btn.Accent}"
                                                        Padding="10,0" Height="26" Margin="0,0,6,0"
                                                        ToolTip="Lưu các thay đổi trên luồng các bước lên Autodesk ACC"
                                                        Click="BtnSaveWorkflowToAcc_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Save24" FontSize="13" Margin="0,0,4,0" />
                                                        <TextBlock Text="Lưu Lên ACC" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="BtnCloneWorkflowToHcm" Style="{StaticResource Btn.Subtle}"
                                                        Padding="10,0" Height="26" Margin="0,0,6,0"
                                                        ToolTip="Sao chép chuẩn hóa quy trình này sang dự án N.DSHCMCG"
                                                        Click="BtnCloneWorkflowToHcm_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Copy24" FontSize="13" Margin="0,0,4,0" />
                                                        <TextBlock Text="Clone sang N.DSHCMCG" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="BtnQuickExportWorkflowJson" Style="{StaticResource Btn.Subtle}"
                                                        Padding="10,0" Height="26"
                                                        ToolTip="Xuất file JSON cấu hình của quy trình"
                                                        Click="BtnQuickExportWorkflowJson_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Code24" FontSize="13" Margin="0,0,4,0" />
                                                        <TextBlock Text="Xem JSON" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Panel sơ đồ các Node -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  Padding="16,14">
                                        <StackPanel x:Name="PanelWorkflowNodes" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Chọn một Quy trình ở bảng trên để xem chi tiết luồng các bước..."
                                                       FontSize="12" FontStyle="Italic"
                                                       Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg3}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ═══ TAB 3: DANH SÁCH ĐỢT TRÌNH DUYỆT HỒ SƠ (REVIEWS) ═══ -->
                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                    BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtReviewSearch" Grid.Column="0" Height="30" Margin="0,0,10,0"
                                             ToolTip="Tìm nhanh tên Đợt duyệt, Quy trình áp dụng, Bước hiện tại, Người xử lý tiếp, Tên file..."
                                             TextChanged="TxtReviewSearch_TextChanged" />
                                    <Border Grid.Column="1" Background="{DynamicResource BIMUP.Fluent.Brush.AccentBg}"
                                            BorderBrush="{DynamicResource BIMUP.Fluent.Brush.AccentStroke}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtReviewSummary" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}"
                                                   Text="0 Đợt trình duyệt (Reviews)" />
                                    </Border>
                                    <Button Grid.Column="2" Style="{StaticResource Btn.Accent}" Padding="14,0" Margin="0"
                                            Click="BtnExportReviewsCsv_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="DocumentTable24" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Xuất Bảng Reviews (.CSV)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- BẢNG REVIEWS -->
                            <Border Grid.Row="1" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                    BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                    CornerRadius="8" Padding="0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}"
                                            BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="0,0,0,1"
                                            CornerRadius="7,7,0,0" Padding="12,6">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="CheckmarkStarburst24" FontSize="15"
                                                               Foreground="{DynamicResource BIMUP.Fluent.Brush.Success}" Margin="0,0,6,0" />
                                                <TextBlock Text="DANH SÁCH ĐỢT TRÌNH DUYỆT HỒ SƠ (REVIEWS)"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg3}"
                                                       Text="💡 Danh sách các đợt trình nộp file đang chờ duyệt hoặc đã hoàn tất" />
                                        </Grid>
                                    </Border>
                                    <DataGrid x:Name="GridReviews" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding SequenceId}" Width="50" FontWeight="Bold" />
                                            <DataGridTextColumn Header="TÊN ĐỢT DUYỆT (REVIEW)" Binding="{Binding Name}" Width="290" FontWeight="SemiBold" />
                                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="90" />
                                            <DataGridTextColumn Header="QUY TRÌNH ÁP DỤNG" Binding="{Binding WorkflowName}" Width="230" />
                                            <DataGridTextColumn Header="BƯỚC HIỆN TẠI" Binding="{Binding CurrentStepName}" Width="150" />
                                            <DataGridTextColumn Header="NGƯỜI XỬ LÝ TIẾP" Binding="{Binding NextActionBy}" Width="170" />
                                            <DataGridTextColumn Header="HẠN XỬ LÝ" Binding="{Binding CurrentStepDueDate}" Width="120" />
                                            <DataGridTextColumn Header="SỐ FILE" Binding="{Binding FilesCount}" Width="70" />
                                            <DataGridTextColumn Header="DANH SÁCH FILE" Binding="{Binding FilesSummary}" Width="330" />
                                            <DataGridTextColumn Header="NGƯỜI TẠO" Binding="{Binding CreatedBy}" Width="135" />
                                            <DataGridTextColumn Header="NGÀY TẠO" Binding="{Binding CreatedAt}" Width="120" />
                                            <DataGridTextColumn Header="NGÀY KẾT THÚC" Binding="{Binding FinishedAt}" Width="120" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ═══ TAB 3: ISSUES & TRANSMITTALS ═══ -->
                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="150" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" MinHeight="150" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                    BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <TextBlock x:Name="TxtIssuesNote" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" FontSize="12"
                                           Text="Danh sách Vấn đề (Issues) và Gói phát hành hồ sơ (Transmittals) của dự án." />
                            </Border>

                            <!-- BẢNG ISSUES -->
                            <Border Grid.Row="1" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                    BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                    CornerRadius="8" Padding="0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}"
                                            BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="0,0,0,1"
                                            CornerRadius="7,7,0,0" Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Warning24" FontSize="15"
                                                           Foreground="{DynamicResource BIMUP.Fluent.Brush.Warning}" Margin="0,0,6,0" />
                                            <TextBlock Text="DANH SÁCH VẤN ĐỀ DỰ ÁN (ACC ISSUES)"
                                                       FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid x:Name="GridIssues" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding DisplayId}" Width="55" FontWeight="Bold" />
                                            <DataGridTextColumn Header="TIÊU ĐỀ ISSUE" Binding="{Binding Title}" Width="250" FontWeight="SemiBold" />
                                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="100" />
                                            <DataGridTextColumn Header="MÔ TẢ CHI TIẾT" Binding="{Binding Description}" Width="250" />
                                            <DataGridTextColumn Header="GIAO CHO" Binding="{Binding AssignedTo}" Width="150" />
                                            <DataGridTextColumn Header="HẠN XỬ LÝ" Binding="{Binding DueDate}" Width="110" />
                                            <DataGridTextColumn Header="VỊ TRÍ" Binding="{Binding LocationDetails}" Width="170" />
                                            <DataGridTextColumn Header="NGƯỜI TẠO" Binding="{Binding CreatedBy}" Width="130" />
                                            <DataGridTextColumn Header="NGÀY TẠO" Binding="{Binding CreatedAt}" Width="120" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

                            <!-- BẢNG TRANSMITTALS -->
                            <Border Grid.Row="3" Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                    BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                    CornerRadius="8" Padding="0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource BIMUP.Fluent.Brush.Layer3}"
                                            BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="0,0,0,1"
                                            CornerRadius="7,7,0,0" Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Send24" FontSize="15"
                                                           Foreground="{DynamicResource BIMUP.Fluent.Brush.Accent}" Margin="0,0,6,0" />
                                            <TextBlock Text="DANH SÁCH HỒ SƠ PHÁT HÀNH (ACC TRANSMITTALS)"
                                                       FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid x:Name="GridTransmittals" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding SequenceId}" Width="55" FontWeight="Bold" />
                                            <DataGridTextColumn Header="TIÊU ĐỀ GÓI PHÁT HÀNH" Binding="{Binding Title}" Width="300" FontWeight="SemiBold" />
                                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="110" />
                                            <DataGridTextColumn Header="SỐ TÀI LIỆU" Binding="{Binding DocsCount}" Width="90" />
                                            <DataGridTextColumn Header="NGƯỜI GỬI" Binding="{Binding CreatedBy}" Width="160" />
                                            <DataGridTextColumn Header="NGÀY GỬI" Binding="{Binding CreatedAt}" Width="140" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ═══ TAB 4: ĐỒNG BỘ & BACKUP ═══ -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Border Style="{StaticResource BIMUP.Fluent.Card}" Padding="20,18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Sao lưu &amp; Đồng bộ Dự án ACC về ổ cứng (Incremental Sync)"
                                                   Style="{StaticResource BIMUP.Fluent.Text.Subtitle}" Margin="0,0,0,4" />
                                        <TextBlock Text="Tự động tái tạo cấu trúc thư mục trên máy tính và chỉ tải file có phiên bản mới hơn."
                                                   Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg3}" FontSize="12" Margin="0,0,0,16" />

                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Thư mục lưu Backup:" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="TxtBackupFolder" Grid.Column="1" Height="32" Text="D:\ACC_Backup" />
                                            <Button Grid.Column="2" Style="{StaticResource Btn.Outline}" Height="32" Margin="8,0,0,0"
                                                    Content="Mở thư mục" Click="BtnOpenBackupFolder_Click" />
                                        </Grid>

                                        <CheckBox x:Name="ChkIncrementalSync" IsChecked="True" Margin="0,8,0,14"
                                                  Content="Chỉ tải các file chưa có trên máy hoặc đã thay đổi dung lượng/Version (Incremental Sync)" />

                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Btn.Accent}" Padding="18,0" Height="34" Click="BtnStartBackupSync_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="CloudArrowDown24" FontSize="16" Margin="0,0,8,0" />
                                                    <TextBlock Text="Bắt đầu Đồng bộ File đã chọn về máy" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ═══ TAB 5: CẤU HÌNH API ═══ -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Border Style="{StaticResource BIMUP.Fluent.Card}" Padding="20,18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Thông tin xác thực Autodesk Platform Services (APS)"
                                                   Style="{StaticResource BIMUP.Fluent.Text.Subtitle}" Margin="0,0,0,12" />

                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="APS Client ID:" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="TxtClientId" Grid.Column="1" Height="32" />
                                        </Grid>

                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="APS Client Secret:" Style="{StaticResource FieldLabel}" />
                                            <PasswordBox x:Name="PwdClientSecret" Grid.Column="1" Height="32" />
                                        </Grid>

                                        <Grid Margin="0,8,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Chế độ xác thực:" Style="{StaticResource FieldLabel}" />
                                            <CheckBox x:Name="ChkUseThreeLegged" Grid.Column="1"
                                                      Content="Đăng nhập tài khoản cá nhân qua trình duyệt (3-Legged OAuth — dùng cho Issues)" />
                                        </Grid>

                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Callback URL (3-Legged):" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="TxtCallbackUrl" Grid.Column="1" Height="32" Text="http://localhost:8080/api/auth/callback" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Style="{StaticResource Btn.Accent}" Padding="16,0" Height="34" Click="BtnSaveAndConnect_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15" Margin="0,0,6,0" />
                                                    <TextBlock Text="Lưu cấu hình &amp; Kết nối ACC" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Btn.Outline}" Padding="12,0" Height="34" Margin="6,0,0,0" Click="BtnOpenApsPortal_Click"
                                                    Content="🌐 Mở APS Developer Portal" />
                                            <Button Style="{StaticResource Btn.Outline}" Padding="12,0" Height="34" Margin="6,0,0,0" Click="BtnOpenAccAdmin_Click"
                                                    Content="🌐 Mở ACC Account Admin" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Hướng dẫn trong Card -->
                                <Border Style="{StaticResource BIMUP.Fluent.Card}" Padding="20,18">
                                    <StackPanel>
                                        <TextBlock Text="📖 Hướng dẫn 2 bước mở khóa API trên Autodesk Construction Cloud"
                                                   Style="{StaticResource BIMUP.Fluent.Text.Subtitle}" Margin="0,0,0,10" />

                                        <TextBlock FontWeight="SemiBold" Margin="0,4,0,2" FontSize="12.5"
                                                   Text="Bước 1: Tạo App trên cổng Autodesk Platform Services (APS)" />
                                        <TextBlock Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" TextWrapping="Wrap" Margin="10,0,0,10" FontSize="12"
                                                   Text="1. Truy cập https://aps.autodesk.com/myapps -> Bấm 'Create Application'.&#x0a;2. Chọn 'Traditional Web App' (Callback: http://localhost:8080/api/auth/callback).&#x0a;3. Bật các API: Data Management API, Autodesk Construction Cloud API, BIM 360 API.&#x0a;4. Copy 'Client ID' và 'Client Secret' dán vào 2 ô ở trên." />

                                        <TextBlock FontWeight="SemiBold" Margin="0,4,0,2" FontSize="12.5"
                                                   Text="Bước 2: Mở Custom Integrations trong ACC Account Admin" />
                                        <TextBlock Foreground="{DynamicResource BIMUP.Fluent.Brush.Fg2}" TextWrapping="Wrap" Margin="10,0,0,2" FontSize="12"
                                                   Text="1. Trên trang https://acc.autodesk.com, góc trên cùng bên trái chuyển sang 'Account Admin'.&#x0a;2. Chọn 'Custom Integrations' (hoặc 'Apps' -> 'Manage custom integrations').&#x0a;3. Bấm 'Add custom integration' -> Dán Client ID vào và bấm Save." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ═══ TAB 6: NHẬT KÝ ═══ -->
                    <TabItem>
                        <Border Background="{DynamicResource BIMUP.Fluent.Brush.CardBg}"
                                BorderBrush="{DynamicResource BIMUP.Fluent.Brush.Stroke1}" BorderThickness="1"
                                CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Style="{StaticResource Btn.Outline}" Height="30" Content="Sao chép nhật ký" Click="BtnCopyLog_Click" />
                                    <Button Style="{StaticResource Btn.Outline}" Height="30" Margin="6,0,0,0" Content="Xóa nhật ký" Click="BtnClearLog_Click" />
                                </StackPanel>
                                <TextBox x:Name="TxtLogs" Grid.Row="1" Style="{StaticResource LogTextBox}" />
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>

                <!-- Thanh tiến trình dưới đáy -->
                <ProgressBar x:Name="ProgressBarMain" Grid.Row="2" Height="3" Margin="20,0,20,0"
                             Visibility="Collapsed" IsIndeterminate="True" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
